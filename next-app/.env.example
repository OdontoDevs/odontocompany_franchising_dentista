# Copie este arquivo para ".env" na raiz do next-app e preencha com os valores reais.
# Nunca commitar o ".env" de verdade.

# Credenciais do app privado (OAuth) criado no RD Station Marketing.
RD_CLIENT_ID=
RD_CLIENT_SECRET=

# URL de callback OAuth. Precisa ser IDÊNTICA à "URL de Callback" cadastrada no app.
# HML: https://hml-odontocompanyfranquiasdentista.agencianewton.com/api/rd-auth/callback
RD_REDIRECT_URI=

# Obtido uma única vez após autorizar o app:
# 1. Configure as 3 variáveis acima e suba a aplicação em HML.
# 2. Acesse /api/rd-auth/start logado na conta do RD Station e autorize o app.
# 3. O RD redireciona para /api/rd-auth/callback, que exibe o refresh_token.
# 4. Copie o valor exibido para cá / painel de env do deploy.
RD_REFRESH_TOKEN=
